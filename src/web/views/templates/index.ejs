<h1>Bildvorlagen</h1>
<p class="unterzeile">
  Vorlagen bestimmen, wie die generierten Karten aussehen — Hintergrund, Position
  von Profilbild und Texten, Farben und Schriftgrössen.
</p>

<div class="knopfreihe abstand-unten">
  <a class="knopf" href="/vorlagen/neu">Neue Vorlage</a>
</div>

<% if (vorlagen.length === 0) { %>
  <div class="karte">
    <div class="leer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="9.5" r="2"/><path d="M21 16l-5-5-6 6"/></svg>
      <p>
        <strong>Noch keine Bildvorlage angelegt</strong>
        Vorlagen bestimmen, wie die Karten in Willkommens- und Rollen-Nachrichten aussehen.
      </p>
      <a class="knopf" href="/vorlagen/neu">Erste Vorlage anlegen</a>
    </div>
  </div>
<% } else { %>
  <div class="vorlagen-galerie">
    <% vorlagen.forEach((v) => { %>
      <div class="karte vorlagen-kachel">
        <h2 class="ohne-abstand-oben"><%= v.name %></h2>
        <p class="hilfe">
          <%= v.kind === 'welcome' ? 'Willkommen' : v.kind === 'role' ? 'Rolle' : 'Allgemein' %>
          · <%= v.width %>×<%= v.height %>
          · <%= v.backgroundFile ? 'mit Hintergrundbild' : 'einfarbig' %>
        </p>
        <div class="knopfreihe">
          <a class="knopf knopf--leise" href="/vorlagen/<%= v.id %>"><%= t('app.bearbeiten') %></a>
          <form method="post" action="/vorlagen/<%= v.id %>/loeschen" data-bestaetigen="<%= t('app.bestaetigen') %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="knopf knopf--gefahr" type="submit"><%= t('app.loeschen') %></button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
