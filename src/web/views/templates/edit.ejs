<h1><%= vorlage.id ? 'Vorlage bearbeiten' : 'Neue Bildvorlage' %></h1>
<p class="unterzeile">Änderungen erscheinen sofort in der Vorschau rechts. Gespeichert wird erst mit dem Knopf unten.</p>

<form method="post" action="/vorlagen" enctype="multipart/form-data" id="vorlagen-formular" data-laden="Wird gespeichert …">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (vorlage.id) { %><input type="hidden" name="id" value="<%= vorlage.id %>"><% } %>
  <input type="hidden" name="config" id="config-feld">

  <div class="editor">
    <div class="editor-felder">
      <fieldset class="gruppe">
        <legend>Allgemein</legend>
        <label>
          <span class="feldname">Name</span>
          <input type="text" name="name" value="<%= vorlage.name %>" required maxlength="80">
        </label>
        <label>
          <span class="feldname">Verwendung</span>
          <select name="kind">
            <option value="welcome" <%= vorlage.kind === 'welcome' ? 'selected' : '' %>>Willkommensnachricht</option>
            <option value="role" <%= vorlage.kind === 'role' ? 'selected' : '' %>>Rollen-Nachricht</option>
            <option value="generic" <%= vorlage.kind === 'generic' ? 'selected' : '' %>>Allgemein</option>
          </select>
        </label>
        <div class="zeile">
          <label><span class="feldname">Breite</span>
            <input type="number" name="width" id="f-width" value="<%= vorlage.width %>" min="100" max="2000"></label>
          <label><span class="feldname">Höhe</span>
            <input type="number" name="height" id="f-height" value="<%= vorlage.height %>" min="100" max="2000"></label>
        </div>
      </fieldset>

      <fieldset class="gruppe">
        <legend>Hintergrund</legend>
        <div class="zeile">
          <label><span class="feldname">Farbe</span>
            <input type="color" data-pfad="background.color"></label>
          <label><span class="feldname">Bildanpassung</span>
            <select data-pfad="background.fit">
              <option value="cover">Füllend (Ausschnitt)</option>
              <option value="contain">Ganz sichtbar</option>
              <option value="stretch">Verzerrt</option>
            </select></label>
        </div>
        <label>
          <span class="feldname">Hintergrundbild (PNG, JPEG oder WebP)</span>
          <input type="file" name="hintergrund" accept="image/png,image/jpeg,image/webp">
          <p class="hilfe">
            Wird erst nach dem Speichern in der Vorschau sichtbar.
            Höchstens <%= vorlage.id ? '' : '' %>einige MB und 4000 Pixel je Kante.
          </p>
        </label>
        <% if (vorlage.backgroundFile) { %>
          <label class="kontrollkaestchen">
            <input type="checkbox" name="hintergrundEntfernen">
            <span>Vorhandenes Hintergrundbild entfernen</span>
          </label>
        <% } %>
        <label class="kontrollkaestchen">
          <input type="checkbox" data-pfad="overlay.enabled">
          <span>Abdunkeln (macht hellen Text lesbar)</span>
        </label>
        <div class="zeile">
          <label><span class="feldname">Farbe</span><input type="color" data-pfad="overlay.color"></label>
          <label><span class="feldname">Stärke</span>
            <input type="number" data-pfad="overlay.opacity" min="0" max="1" step="0.05"></label>
        </div>
      </fieldset>

      <fieldset class="gruppe">
        <legend>Profilbild</legend>
        <label class="kontrollkaestchen">
          <input type="checkbox" data-pfad="avatar.enabled"><span>Anzeigen</span>
        </label>
        <div class="zeile">
          <label><span class="feldname">X</span><input type="number" data-pfad="avatar.x" data-zieh="avatar"></label>
          <label><span class="feldname">Y</span><input type="number" data-pfad="avatar.y" data-zieh="avatar"></label>
          <label><span class="feldname">Grösse</span><input type="number" data-pfad="avatar.size" min="16" max="2000"></label>
        </div>
        <div class="zeile">
          <label><span class="feldname">Form</span>
            <select data-pfad="avatar.shape">
              <option value="circle">Kreis</option>
              <option value="rounded">Abgerundet</option>
              <option value="square">Quadrat</option>
            </select></label>
          <label><span class="feldname">Eckenradius</span><input type="number" data-pfad="avatar.radius" min="0" max="200"></label>
        </div>
        <div class="zeile">
          <label class="kontrollkaestchen"><input type="checkbox" data-pfad="avatar.border.enabled"><span>Rand</span></label>
          <label><span class="feldname">Breite</span><input type="number" data-pfad="avatar.border.width" min="0" max="40"></label>
          <label><span class="feldname">Farbe</span><input type="color" data-pfad="avatar.border.color"></label>
        </div>
      </fieldset>

      <% ['username', 'subtitle'].forEach((block) => { %>
        <fieldset class="gruppe">
          <legend><%= block === 'username' ? 'Name' : 'Zweite Zeile' %></legend>
          <label class="kontrollkaestchen">
            <input type="checkbox" data-pfad="<%= block %>.enabled"><span>Anzeigen</span>
          </label>
          <label>
            <span class="feldname">Text</span>
            <input type="text" data-pfad="<%= block %>.text" maxlength="200">
          </label>
          <div class="zeile">
            <label><span class="feldname">X</span><input type="number" data-pfad="<%= block %>.x" data-zieh="<%= block %>"></label>
            <label><span class="feldname">Y</span><input type="number" data-pfad="<%= block %>.y" data-zieh="<%= block %>"></label>
            <label><span class="feldname">Grösse</span><input type="number" data-pfad="<%= block %>.size" min="8" max="200"></label>
          </div>
          <div class="zeile">
            <label><span class="feldname">Schrift</span>
              <select data-pfad="<%= block %>.font">
                <option value="Inter Regular">Normal</option>
                <option value="Inter Bold">Fett</option>
              </select></label>
            <label><span class="feldname">Ausrichtung</span>
              <select data-pfad="<%= block %>.align">
                <option value="left">Links</option>
                <option value="center">Zentriert</option>
                <option value="right">Rechts</option>
              </select></label>
            <label><span class="feldname">Farbe</span><input type="color" data-pfad="<%= block %>.color"></label>
          </div>
          <div class="zeile">
            <label><span class="feldname">Max. Breite</span>
              <input type="number" data-pfad="<%= block %>.maxWidth" min="50" max="2000"></label>
            <label class="kontrollkaestchen"><input type="checkbox" data-pfad="<%= block %>.shadow.enabled"><span>Schatten</span></label>
          </div>
          <p class="hilfe">Zu langer Text wird automatisch verkleinert, bis er in die max. Breite passt.</p>
        </fieldset>
      <% }) %>
    </div>

    <div class="editor-vorschau">
      <div class="vorschau-huelle">
        <div class="karte">
          <h2 class="ohne-abstand-oben">Vorschau</h2>
          <img class="vorschau-bild" id="vorschau" alt="Vorschau der Bildvorlage">
          <p class="hilfe" id="vorschau-status">
            Ziehe das Profilbild oder die Texte direkt im Bild, um sie zu positionieren.
          </p>
          <label>
            <span class="feldname">Vorschau mit</span>
            <select id="vorschau-nutzer">
              <option value="">Beispieldaten (Max Mustermann)</option>
              <% mitglieder.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.displayName %></option>
              <% }) %>
            </select>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="knopfreihe">
    <button class="knopf" type="submit"><%= t('app.speichern') %></button>
    <a class="knopf knopf--leise" href="/vorlagen"><%= t('app.abbrechen') %></a>
  </div>
</form>

<script type="application/json" id="vorlagen-daten">
  <%- JSON.stringify({ id: vorlage.id, config: vorlage.config, width: vorlage.width, height: vorlage.height }) %>
</script>
