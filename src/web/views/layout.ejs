<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="color-scheme" content="dark">
  <title><%= typeof titel !== 'undefined' ? titel + ' · ' : '' %><%= t('app.titel') %></title>
  <link rel="stylesheet" href="/css/panel.css">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
</head>
<body class="<%= user ? 'mit-leiste' : 'ohne-leiste' %>">
  <% if (user) { %>
    <%- include('partials/nav') %>
  <% } %>

  <main class="inhalt" id="inhalt">
    <%- include('partials/flash') %>
    <%- koerper %>
  </main>

  <script type="module" src="/js/common.js"></script>
  <% if (typeof seitenSkript !== 'undefined' && seitenSkript) { %>
    <script type="module" src="/js/<%= seitenSkript %>"></script>
  <% } %>
</body>
</html>
