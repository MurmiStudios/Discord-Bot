<%- include('partials/header') %>
<div class="login-box">
  <div class="login-mark">D</div>
  <h1>Discord-Panel</h1>
  <p class="muted">
    Kein eigenes Passwort — melde dich mit deinem Discord-Konto an.
    Deine Mitgliedschaft und Rollen auf dem Server entscheiden, was du siehst.
  </p>
  <a href="<%= authUrl %>" class="btn btn-primary btn-block">Mit Discord anmelden</a>
  <% if (bootstrapOpen) { %>
    <p class="notice notice-info">Noch kein Panel-Administrator eingerichtet: Die erste Anmeldung einer Person mit Server-Administrator-Rechten erhält automatisch vollen Zugriff.</p>
  <% } %>
</div>
<%- include('partials/footer') %>
