<h1>Kanal-Nachricht</h1>
<p class="unterzeile">Sende eine Nachricht in einen Kanal des Servers.</p>

<form method="post" action="/kanaele" class="karte" data-laden="Wird gesendet …">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label>
    <span class="feldname">Kanal</span>
    <select name="channelId" required>
      <option value="">— bitte wählen —</option>
      <% kanaele.forEach((k) => { %>
        <option value="<%= k.id %>" <%= k.beschreibbar ? '' : 'disabled' %>>
          <%= k.parent ? k.parent + ' / ' : '' %>#<%= k.name %><%= k.beschreibbar ? '' : ' — ' + k.grund %>
        </option>
      <% }) %>
    </select>
    <p class="hilfe">Kanäle ohne Schreibrecht des Bots sind nicht auswählbar.</p>
  </label>

  <label>
    <span class="feldname">Titel (optional — erzeugt ein Embed)</span>
    <input type="text" name="title" maxlength="256" placeholder="z. B. Ankündigung">
  </label>

  <label>
    <span class="feldname">Text</span>
    <textarea name="content" maxlength="4000" placeholder="Deine Nachricht …"></textarea>
  </label>

  <label>
    <span class="feldname">Aktionsleiste (optional — hängt Buttons an die Nachricht)</span>
    <select name="buttonSetId">
      <option value="">— ohne Buttons —</option>
      <% leisten.forEach((l) => { %>
        <option value="<%= l.id %>"><%= l.name %></option>
      <% }) %>
    </select>
    <% if (leisten.length === 0) { %>
      <p class="hilfe">Noch keine Leiste vorhanden — <a href="/aktionsleisten">jetzt eine anlegen</a>.</p>
    <% } %>
  </label>

  <button class="knopf" type="submit"><%= t('app.senden') %></button>
</form>
