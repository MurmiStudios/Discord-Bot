<div class="fehler-karte">
  <h1><%= titel %></h1>
  <pre class="fehler-text"><%= nachricht %></pre>
  <div class="knopfreihe">
    <a class="knopf" href="/">Zur Übersicht</a>
    <% if (zeigeAbmelden) { %>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="knopf knopf--leise" type="submit"><%= t('app.abmelden') %></button>
      </form>
    <% } %>
  </div>
</div>
