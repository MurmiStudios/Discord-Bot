# ─────────────────────────────────────────────────────────────
#  Discord-Bot mit Webpanel — Konfiguration
#  Diese Datei nach ".env" kopieren und ausfüllen.
#  Die .env selbst gehört NIEMALS ins Git (steht in .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Discord-Bot ──────────────────────────────────────────────
# Developer Portal → Applications → deine App → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# ID des Servers, den das Panel verwaltet (Rechtsklick auf den Server →
# "Server-ID kopieren", dazu muss der Entwicklermodus aktiv sein)
GUILD_ID=

# ── OAuth2 / Panel-Zugriff ───────────────────────────────────
# Muss im Developer Portal unter OAuth2 → Redirects EXAKT so eingetragen sein
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# Komma-getrennte Discord-User-IDs mit Vollzugriff aufs Panel
PANEL_ADMIN_IDS=
# true = zusätzlich darf jeder Server-Administrator ins Panel
PANEL_REQUIRE_GUILD_ADMIN=true
# Optional: Komma-getrennte Rollen-IDs, die ebenfalls Zugriff bekommen
PANEL_ALLOWED_ROLE_IDS=

# ── Webserver ────────────────────────────────────────────────
PORT=3000
# Öffentlich erreichbare URL des Panels (für Weiterleitungen und Cookies)
BASE_URL=http://localhost:3000
# Mindestens 32 Zeichen. Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=
# 1 setzen, wenn das Panel hinter nginx/Traefik/Caddy läuft
TRUST_PROXY=0
# production erzwingt Secure-Cookies und HTTPS in BASE_URL
NODE_ENV=development

# ── Speicher / Uploads ───────────────────────────────────────
DATA_DIR=./data
# Obergrenze für hochgeladene Hintergrundbilder (Megabyte)
MAX_UPLOAD_MB=8
# Maximale Kantenlänge in Pixeln, schützt vor Dekompressionsbomben
MAX_IMAGE_DIMENSION=4000

# ── Versand ──────────────────────────────────────────────────
# Pause zwischen zwei DMs beim Massenversand (Millisekunden)
DM_DELAY_MS=1500
# Sicherheitslimit: maximale Empfängerzahl pro Panel-Aktion
DM_MAX_RECIPIENTS=200

# ── Protokollierung ──────────────────────────────────────────
LOG_LEVEL=info
