# Discord-Anwendung (Discord Developer Portal -> deine Anwendung)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Muss exakt der Redirect-URI in der Discord-Anwendung entsprechen,
# z. B. https://panel.example.com/auth/callback oder http://localhost:3000/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Basis-URL des Panels, ohne abschliessenden Slash
BASE_URL=http://localhost:3000
PORT=3000

# Zufälliger, langer Zufallsstring (z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Kommagetrennte Discord-User-IDs mit vollem Panel-Zugriff
PANEL_ADMIN_IDS=

# Kommagetrennte Rollen-IDs, die zusätzlich Zugriff erhalten
PANEL_ALLOWED_ROLE_IDS=

# 1 = Mitglieder mit der Discord-Berechtigung "Administrator" auf dem Server
# erhalten ebenfalls Zugriff (als "Server-Administrator")
PANEL_SERVER_ADMIN_ACCESS=1

# Muss auf 1 stehen, wenn das Panel hinter einem Reverse-Proxy mit HTTPS läuft
# (sonst wird das Sitzungs-Cookie nicht als Secure gesetzt und der Start bricht ab)
TRUST_PROXY=0

# Maximale Anzahl Empfänger je Massenversand
DM_MAX_RECIPIENTS=200
# Pause zwischen zwei Direktnachrichten in Millisekunden
DM_DELAY_MS=1500
