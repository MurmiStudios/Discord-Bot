{
  "name": "discord-bot-webpanel",
  "version": "1.0.0",
  "description": "Discord-Bot mit Webpanel: DMs, Kanal-Nachrichten, Rollen-Nachrichten und Willkommensnachrichten mit dynamisch generierten Bildern sowie automatische Rollenregeln.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "render:sample": "node scripts/render-sample.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "better-sqlite3": "^13.0.3",
    "csrf-sync": "^4.2.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^10.3.1"
  }
}
